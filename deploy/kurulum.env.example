# Bu dosyayı kurulum.env olarak kopyalayın ve "degistir" değerlerini doldurun. kurulum.env git'e girmez.
# Alan adı (DNS bu sunucuya yönlenmiş olmalı)
DOMAIN=degistir.ornek-firma.com.tr
# Veritabanı parolası (uzun, rastgele)
DB_PASSWORD=degistir-uzun-rastgele-parola
# En az 32 karakter rastgele: openssl rand -base64 48
BETTER_AUTH_SECRET=degistir-en-az-32-karakter-rastgele
BETTER_AUTH_URL=https://degistir.ornek-firma.com.tr
DB_APP_ROLE=app_user
STORAGE_DRIVER=fs
# İsteğe bağlı S3 uyumlu depolama (STORAGE_DRIVER=s3 ise)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# E-posta (davet ve parola sıfırlama): smtp://kullanici:parola@sunucu:587
SMTP_URL=
SMTP_FROM=
# Yedek şifreleme: age açık anahtarı (gizli anahtar sunucuda TUTULMAZ)
YEDEK_ACIK_ANAHTAR=degistir-age1...
# İlk yönetici (yalnızca kurulum komutu kullanır)
KURULUM_ADMIN_EMAIL=
KURULUM_ADMIN_NAME=
KURULUM_ADMIN_PASSWORD=
